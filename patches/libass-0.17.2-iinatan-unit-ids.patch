+void ass_iinatan_set_lookup_units(ASS_Renderer *renderer,
+                                 const ASS_IinatanLookupUnit *units, int count)
+{
+    if (!renderer)
+        return;
+    renderer->lookup_unit_count = 0;
+    if (!units || count <= 0)
+        return;
+    count = FFMIN(count, 256);
+    memcpy(renderer->lookup_units, units, count * sizeof(*units));
+    renderer->lookup_unit_count = count;
+}
+
+int ass_iinatan_lookup_units_valid(ASS_Renderer *renderer)
+{
+    return renderer && renderer->lookup_units_valid;
+}
+
+int ass_iinatan_get_lookup_rects(ASS_Renderer *renderer,
+                                ASS_IinatanLookupRect *rects, int capacity)
+{
+    if (!renderer)
+        return 0;
+    int count = renderer->lookup_rect_count;
+    if (rects && capacity > 0)
+        memcpy(rects, renderer->lookup_rects,
+               FFMIN(count, capacity) * sizeof(*rects));
+    return count;
+}
