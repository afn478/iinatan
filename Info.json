{
  "name": "iinatan",
  "identifier": "com.afn478.iinatan",
  "version": "2.1.6",
  "author": {
    "name": "afn478"
  },
  "description": "Hover subtitles to see dictionary popups in IINA.",
  "entry": "main.js",
  "globalEntry": "global.js",
  "preferencesPage": "preferences.html",
  "helpPage": "README.md",
  "ghRepo": "afn478/iinatan",
  "ghVersion": 216,
  "preferenceDefaults": {
    "enabledByDefault": true,
    "hideNativeSubtitles": true,
    "bitmapSubtitleOcrEnabled": true,
    "bitmapSubtitleOcrPrefetchEnabled": false,
    "bitmapSubtitleOcrScreenshotFallbackEnabled": false,
    "bitmapSubtitleOcrNoticeVersion": 0,
    "experimentalNativeSubtitleHitLayer": true,
    "experimentalNativeSubtitleLookupHighlight": true,
    "experimentalNativeSubtitleHitBoxes": false,
    "experimentalNativeSubtitleTextOpacity": 0,
    "experimentalNativeSubtitleValidation": false,
    "audioAutoPlay": false,
    "audioSourcesJson": "[{\"url\":\"http://127.0.0.1:5050/?term={term}&reading={reading}\"}]",
    "ankiEnabled": false,
    "ankiConnectUrl": "http://127.0.0.1:8765",
    "ankiConnectTimeoutSeconds": 3,
    "ankiDeckName": "",
    "ankiModelName": "",
    "ankiFieldTemplatesJson": "{}",
    "ankiTags": "iinatan",
    "ankiAudioFormat": "mp3",
    "ankiAudioBitrateKbps": 96,
    "ankiImageQuality": 85,
    "ankiDuplicateCheck": true,
    "ankiDuplicateMode": "prevent",
    "ankiDuplicateScope": "deck",
    "ankiSentenceAudioPaddingMs": 250,
    "lookupLanguage": "ja",
    "fontScale": 1.0,
    "popupScale": 0.92,
    "popupMinWidth": 250,
    "popupMaxWidth": 440,
    "popupTheme": "inherit",
    "maxEntries": 3,
    "maxGlossesPerEntry": 4,
    "scanLength": 24,
    "hoverRequestTimeoutMs": 15000,
    "backendTimeoutMs": 30000,
    "importTimeoutMs": 1800000,
    "lowRamImport": true,
    "subtitlePollMs": 120,
    "popupMaxHeightVh": 34,
    "popupSubtitleGapPx": 34,
    "subtitleLookupMode": "hover",
    "nestedPopupMode": "off",
    "nestedPopupMaxDepth": 3,
    "flattenSubtitleLineBreaks": false,
    "pauseWhilePopupVisible": true,
    "lookupTimeoutMs": 9000,
    "etymologyCollapseDefault": "collapsed",
    "wiktionaryEtymologyCollapseOverride": "collapsed",
    "customPopupCss": "",
    "debugLogEnabled": true,
    "debugLogVerbose": false,
    "directWorkerIpc": true,
    "fallbackToClientExec": true,
    "directIpcPollMs": 2,
    "workerIdleSleepMs": 2,
    "controllerEnabled": false,
    "controllerNoPopupBindingsJson": "{\"primary\":\"lookup\",\"back\":\"resume-playback\",\"square\":\"toggle-pause\",\"audio\":\"audio-menu\",\"leftShoulder\":\"subtitle-previous\",\"rightShoulder\":\"subtitle-next\",\"leftTrigger\":\"anki-force-add\",\"rightTrigger\":\"anki-primary\",\"dpadUp\":\"volume-up\",\"dpadDown\":\"volume-down\",\"dpadLeft\":\"seek-backward\",\"dpadRight\":\"seek-forward\"}",
    "controllerPopupBindingsJson": "{\"primary\":\"lookup\",\"back\":\"close-popup\",\"square\":\"toggle-pause\",\"audio\":\"audio-menu\",\"leftShoulder\":\"subtitle-previous\",\"rightShoulder\":\"subtitle-next\",\"leftTrigger\":\"anki-force-add\",\"rightTrigger\":\"anki-primary\",\"dpadUp\":\"popup-scroll-up\",\"dpadDown\":\"popup-scroll-down\",\"dpadLeft\":\"popup-left\",\"dpadRight\":\"popup-right\"}",
    "controllerAudioBindingsJson": "{\"primary\":\"audio-activate\",\"back\":\"close-audio-list\",\"square\":\"none\",\"audio\":\"none\",\"leftShoulder\":\"none\",\"rightShoulder\":\"none\",\"leftTrigger\":\"none\",\"rightTrigger\":\"none\",\"dpadUp\":\"audio-up\",\"dpadDown\":\"audio-down\",\"dpadLeft\":\"audio-left\",\"dpadRight\":\"audio-right\"}"
  },
  "permissions": [
    "video-overlay",
    "network-request",
    "file-system",
    "show-osd",
    "show-alert"
  ],
  "allowedDomains": [
    "*"
  ]
}
